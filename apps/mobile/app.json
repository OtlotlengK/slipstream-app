{
  "expo": {
    "name": "VynoTap",
    "slug": "vynotap",
    "scheme": "vynotap",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "../../icons/vynotap.png",
    "splash": {
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vynotap.app"
    },
    "android": {
      "package": "com.vynotap.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
